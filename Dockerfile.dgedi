# dGeDi (distilled GeDi, IROS'25 — tev-fbk/dGeDi) geometry-descriptor service.
# Isolated CUDA 11.8 / torch 2.1 env (the oscar image is CUDA 12.x), same pattern
# as the gedi and foundationpose services. Everything installs from prebuilt
# wheels — PTV3 is vendored in the dGeDi repo's core/ and flash-attn is optional
# (enable_flash: False in the config) — so there is NO CUDA compilation here.
#
# The dGeDi repo + weights + server script are bind-mounted at /workspace
# (../dGeDi), so this image only provides the environment.
#
# Build:  docker compose build dgedi     (or: docker build -f Dockerfile.dgedi -t oscar-dgedi .)
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev git wget libgl1 libgomp1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --upgrade pip

# PyTorch 2.1.0 + CUDA 11.8 (bundles its own CUDA/cuDNN runtime libs)
RUN pip install --no-cache-dir torch==2.1.0 torchvision==0.16.0 torchaudio==2.1.0 \
    --index-url https://download.pytorch.org/whl/cu118

# Scientific stack + PTV3/dGeDi utilities
RUN pip install --no-cache-dir numpy==1.26.4 scipy h5py==3.14.0 pyyaml \
    setuptools wheel ninja addict einops plyfile termcolor yapf loguru \
    timm==0.6.13 opencv-python-headless==4.10.0.84

# PyTorch Geometric (prebuilt wheels for torch-2.1+cu118)
RUN pip install --no-cache-dir torch-geometric && \
    pip install --no-cache-dir torch-scatter torch-sparse torch-cluster \
    -f https://data.pyg.org/whl/torch-2.1.0+cu118.html

# spconv + Open3D + serving/util deps
RUN pip install --no-cache-dir spconv-cu118==2.3.8 open3d==0.17.0 \
    huggingface_hub tqdm scikit-learn flask httpx

WORKDIR /workspace
CMD ["bash"]
